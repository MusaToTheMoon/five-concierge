# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# specific files/folders
prep.txt
temp.txt
screenshot-*.png

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# local scratch and working notes
/.superpowers
/docs/PROGRESS.md
/docs/plans/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — keep the example committed
.env*
!.env.example

# generated embeddings (rebuild with `npm run ingest`)
/data/embeddings.json

# benchmark results (regenerated by `npm run bench` / `npm run bench:live`)
/bench/results/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
